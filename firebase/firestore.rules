rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerResource() {
      return isSignedIn() && request.auth.uid == resource.data.idUser;
    }

    function isOwnerRequest() {
      return isSignedIn() && request.auth.uid == request.resource.data.idUser;
    }

    match /users/{userId} {
      allow read, update, delete: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == resource.data.idUser);
      allow create: if isSignedIn() && request.auth.uid == userId && request.auth.uid == request.resource.data.idUser;
    }

    match /habits/{habitId} {
      allow read, update, delete: if isOwnerResource();
      allow create: if isOwnerRequest();
    }

    match /habit_logs/{logId} {
      allow read, update, delete: if isOwnerResource();
      allow create: if isOwnerRequest();
    }

    match /recommendations/{recommendationId} {
      allow read, update, delete: if isOwnerResource();
      allow create: if isOwnerRequest();
    }
  }
}
